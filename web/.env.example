# Public base URL of the deployed site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://richemakso.vercel.app

# --- Contact form (server-side only, never exposed to the browser) ---
# Without SMTP_HOST the form shows a clear "not enabled" message instead of pretending to send.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); leave empty to infer from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender address of the outgoing emails (defaults to SMTP_USER). Must be allowed by your SMTP provider.
MAIL_FROM=
# Mailbox that receives the "message from the portfolio" notifications.
CONTACT_TO=maksoricheisaac@gmail.com
