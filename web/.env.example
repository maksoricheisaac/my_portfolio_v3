# Public base URL of the deployed site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://richemakso.vercel.app

# --- Back-end (NestJS API, see ../api) ---
# Private URL of the API, used by the Next.js server and by the /backend/* proxy.
API_URL=http://localhost:4000
# Shared with the API: lets the contact form forward the real visitor IP for rate limiting.
INTERNAL_API_KEY=
# Number of reverse proxies in front of Next.js that append to X-Forwarded-For (Traefik/Dokploy = 1,
# local development = 0). Used to derive the real visitor IP; never trust more hops than you have.
TRUSTED_PROXY_HOPS=0
# Shared with the API (REVALIDATE_SECRET): authorises /api/revalidate after admin changes.
REVALIDATE_SECRET=
