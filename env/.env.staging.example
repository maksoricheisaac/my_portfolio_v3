# STAGING — paste into Dokploy > your Compose service > Environment.
# Same repo, same compose file as production; use another Dokploy service (or environment),
# optionally on a "staging" branch. Never indexed (SITE_ENV != production).
# Generate the secrets with: sh infra/scripts/gen-secrets.sh  (different from production!)
SITE_ENV=staging
SITE_URL=https://staging.example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=
INTERNAL_API_KEY=
REVALIDATE_SECRET=

# Option A — real SMTP (use a test mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=

# Option B — catch every mail in Mailpit instead (leave SMTP_* empty, then add a Dokploy domain on
# service `mailpit`, port 8025).
# COMPOSE_PROFILES=mailcatcher
# MAILPIT_AUTH=admin:REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false

# Optional: fixed setup token for the first-run wizard (/admin/setup). Without it, a random token
# is printed in the api logs at startup.
# SETUP_TOKEN=
