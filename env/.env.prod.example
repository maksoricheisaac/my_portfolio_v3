# PRODUCTION — paste into Dokploy > your Compose service > Environment.
# Generate the secrets with: sh infra/scripts/gen-secrets.sh  (32+ chars, all different)
SITE_ENV=production
SITE_URL=https://example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=
INTERNAL_API_KEY=
REVALIDATE_SECRET=

# SMTP is required in production: it delivers the sign-in OTP codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=

# Nightly database dumps (volume db_backups).
COMPOSE_PROFILES=backup

# Optional: fixed setup token for the first-run wizard (/admin/setup). Without it, a random token
# is printed in the api logs at startup.
# SETUP_TOKEN=
