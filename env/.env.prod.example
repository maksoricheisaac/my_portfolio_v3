# PRODUCTION: paste into Dokploy > Compose service > Environment.
# Compose path: ./docker-compose.prod.yml
# Generate the secrets with: sh infra/scripts/gen-secrets.sh (all different, never reused elsewhere)
SITE_URL=https://example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=
INTERNAL_API_KEY=
REVALIDATE_SECRET=

# Traefik only: web=1, api=2. Behind Cloudflare as well: TRUSTED_PROXY_HOPS=2, TRUST_PROXY=3.
TRUSTED_PROXY_HOPS=1
TRUST_PROXY=2

# SMTP is required in production: it delivers the sign-in OTP codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=

# First run: leave empty (the setup token is printed in the api logs).
# SETUP_TOKEN=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   # remove after the first deploy
