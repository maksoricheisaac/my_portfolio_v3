# DEVELOPMENT: paste into Dokploy > Compose service > Environment.
# Compose path: ./docker-compose.dev.yml
# Mails are caught by Mailpit (nothing leaves the server). Never indexed.
# Generate the secrets with: sh infra/scripts/gen-secrets.sh (different from production!)
SITE_URL=https://dev.example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=
INTERNAL_API_KEY=
REVALIDATE_SECRET=

TRUSTED_PROXY_HOPS=1
TRUST_PROXY=2

# Mailpit UI: add a Dokploy domain on service `mailpit`, port 8025. Required, user:password.
MAILPIT_AUTH=admin:REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MAIL_FROM=
CONTACT_TO=
# Real test mailbox instead of Mailpit: set SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASS.

# SETUP_TOKEN=
