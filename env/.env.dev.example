# DEVELOPMENT: paste into Dokploy > Compose service > Environment.
# Compose path: ./docker-compose.dev.yml
# Mails are caught by Mailpit (nothing leaves the server). Never indexed.
# Every secret must be different, and different from production (32+ chars).
# Generate ONE secret (Node.js, 48 URL-safe chars; run it once per variable, values must differ):
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Generate all the secrets at once (copy the output below):
#   node -e "for (const n of ['POSTGRES_PASSWORD','JWT_ACCESS_SECRET','OTP_SECRET','INTERNAL_API_KEY','REVALIDATE_SECRET']) console.log(n+'='+require('crypto').randomBytes(36).toString('base64url'))"
# Or with the shell script: sh infra/scripts/gen-secrets.sh
SITE_URL=https://dev.example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=
INTERNAL_API_KEY=
REVALIDATE_SECRET=

TRUSTED_PROXY_HOPS=1
TRUST_PROXY=2

# Mailpit UI: add a Dokploy domain on service `mailpit`, port 8025. Required, user:password.
# Mailpit password (32 chars):
#   node -e "console.log('MAILPIT_AUTH=admin:'+require('crypto').randomBytes(24).toString('base64url'))"
MAILPIT_AUTH=admin:REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Bare address that IS the SMTP account (or an alias), e.g. contact@your-domain. No "Name <...>".
MAIL_FROM=
CONTACT_TO=
# Real test mailbox instead of Mailpit: set SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASS.

# SETUP_TOKEN=
