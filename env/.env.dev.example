# DEVELOPMENT (shared integration server) — paste into Dokploy > Environment.
# Every mail is caught by Mailpit: nothing leaves the server. Never indexed.
# Generate the secrets with: sh infra/scripts/gen-secrets.sh
SITE_ENV=dev
SITE_URL=https://dev.example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=
INTERNAL_API_KEY=
REVALIDATE_SECRET=

# Mailpit: add a Dokploy domain (e.g. mail.dev.example.com) on service `mailpit`, port 8025.
COMPOSE_PROFILES=mailcatcher
MAILPIT_AUTH=admin:REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=portfolio-dev@dev.example.com
CONTACT_TO=dev@dev.example.com

# Optional: fixed setup token for the first-run wizard (/admin/setup). Without it, a random token
# is printed in the api logs at startup.
# SETUP_TOKEN=
