# LOCAL — api and web run natively; Docker only provides PostgreSQL + Mailpit:
#   docker compose -f docker-compose.local.yml up -d
# This file is a reference: copy the blocks below into api/.env and web/.env.local.
#
# ── api/.env ─────────────────────────────────────────────
# NODE_ENV=development
# PORT=4000
# TRUST_PROXY=1
# DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public
# WEB_ORIGINS=http://localhost:3000
# SITE_URL=http://localhost:3000
# JWT_ACCESS_SECRET=<48+ random chars>
# OTP_SECRET=<48+ random chars>
# INTERNAL_API_KEY=<same value as web>
# REVALIDATE_SECRET=<same value as web>
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM=portfolio@localhost
# CONTACT_TO=me@localhost.dev
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<12+ chars, 3 character classes>
#
# ── web/.env.local ───────────────────────────────────────
# API_URL=http://localhost:4000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_ENV=local
# INTERNAL_API_KEY=<same as api>
# REVALIDATE_SECRET=<same as api>
#
# Mails and OTP codes: http://localhost:8025 (Mailpit).
