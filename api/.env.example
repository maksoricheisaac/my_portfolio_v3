# --- Runtime ---
NODE_ENV=development
PORT=4000
# Reverse proxies in front of the API, needed for correct client IPs (rate limiting, audit).
# Local dev: 1 (Next.js /backend proxy). Behind Traefik/Dokploy: 2 (Traefik + Next.js).
# The API must NOT be reachable from the Internet except through the site.
TRUST_PROXY=1

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public

# --- Website ---
# Browser origins allowed to call the API (comma-separated, no trailing slash).
WEB_ORIGINS=http://localhost:3000
# Public site URL (used in emails). Defaults to the first WEB_ORIGINS entry.
SITE_URL=http://localhost:3000
# Shared secret with the Next.js server: lets it forward the real visitor IP. 24+ chars.
INTERNAL_API_KEY=
# On-demand revalidation of the website after admin changes (same secret in web/.env).
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# --- Security secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=
OTP_SECRET=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# Set when the admin and API live on sibling sub-domains.
COOKIE_DOMAIN=
# Always secure in production; set true to test Secure cookies over HTTPS locally.
COOKIE_SECURE=false

# --- Email (OTP codes, contact notifications). Local: Mailpit on localhost:1025 (UI :8025). ---
# Without SMTP_HOST codes are printed in the dev console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=

# --- Media ---
UPLOAD_DIR=./uploads
MEDIA_PUBLIC_PATH=/backend/media

# --- Seed (pnpm db:seed) ---
ADMIN_EMAIL=
ADMIN_NAME=Riche Makso
# 12+ chars, 3 of 4 classes (lower/upper/digit/symbol). Remove from .env after seeding.
ADMIN_PASSWORD=
